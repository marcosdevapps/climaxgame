# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local al repositorio.

# URL pública del sitio (metadatos, Open Graph, redirecciones de Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: ignora RLS. Se usa en el sync del catálogo y el borrado de cuentas.
SUPABASE_SECRET_KEY=

# Google OAuth para Supabase local (supabase/config.toml). En producción se configura en el dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# IGDB (portal de desarrolladores de Twitch) · sprint 2
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Traducción de sinopsis con Claude · sprint 2
ANTHROPIC_API_KEY=

# Protege /api/cron/* (Vercel Cron lo envía como Bearer token)
CRON_SECRET=
